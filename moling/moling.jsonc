    // 创建时间（ISO 8601 格式）
    "創建時間": "2026-05-31T10:22:07.686Z",
    // 更新时间（ISO 8601 格式）
    "更新時間": "2026-05-31T10:22:07.686Z"
  },
  // 方案参数
  "方案參數": {
    // 最大编码长度，如 4 或 5
    "最大碼長": 4,
    // 编码终止指示符列表，如 ["a", "o", "e", "i", "u", "_"]（可选）
    "編碼終止指示符列表": ["a", "o", "e", "i", "u", "_"],
    // 选重键是否计入编码长度（默认 false）
