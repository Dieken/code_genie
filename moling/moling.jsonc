    // 标签列表，如 ["形碼", "前綴碼", "五碼"]（可选）
      "標籤": ["純形", "碼長上限4", "字根雙編碼", "字根三編碼", "大碼形聚", "大碼亂序", "小碼音托", "小碼筆畫", "無空格自分割", "回頭碼", "兩根字回頭", "繁簡字根分離", "字母編碼", "25鍵"],
    // 相关资源链接列表（教程、社群等）（可选）
    "相關資源鏈接": [],
    // 码表下载链接（可选）
